# Üretim ortamı şablonu; mevcut yerel .env dosyasının üzerine yazılmaz.
# APP_KEY, yeni üretim DB hesabı ve SMTP alanları özel .env içinde doldurulmadan etkinleştirilmez.
# Ayrıntılar: docs/operations.md — Üretim ortamı şablonu.

APP_NAME="mADEMatik Solutions"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://madematik.com

APP_LOCALE=tr
APP_FALLBACK_LOCALE=tr
APP_FAKER_LOCALE=tr_TR
APP_MAINTENANCE_DRIVER=file
BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=warning

# Yalnız bu proje için oluşturulan yeni üretim DB'si ve sınırlı kullanıcı.
# Hosting değerleri doldurulur; DB_OWNERSHIP, DB_DATABASE ile birebir aynı olmalıdır.
DB_CONNECTION=mysql
DB_HOST=
DB_PORT=
DB_SOCKET=
DB_DATABASE=
DB_USERNAME=
DB_PASSWORD=
DB_OWNERSHIP=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null
SESSION_SECURE_COOKIE=true
SESSION_HTTP_ONLY=true
SESSION_SAME_SITE=lax

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
CACHE_STORE=database

# database yalnız çalışan ve doğrulanmış worker/cron varsa etkinleştirilir.
# Worker hazır değilse aktif gönderim için QUEUE_CONNECTION=sync seçilir.
QUEUE_CONNECTION=database

# Bu projenin özel .env dosyasındaki onaylı SMTP değerleri güvenli biçimde aktarılır.
# smtp + MAIL_REQUIRE_TLS=true STARTTLS içindir; sağlayıcı SMTPS istiyorsa smtps seçilir.
MAIL_MAILER=smtp
MAIL_SCHEME=smtp
MAIL_HOST=
MAIL_PORT=
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM_ADDRESS=
MAIL_FROM_NAME="${APP_NAME}"
MAIL_ALLOW_LOCAL_SEND=false
MAIL_ADMIN_NOTIFICATION_ADDRESS=
MAIL_TIMEOUT=15
MAIL_REQUIRE_TLS=true

VITE_APP_NAME="${APP_NAME}"
